rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Прогресс начисляет сервер (docs/specs/00-server.md): эти поля профиля клиент менять не может
    function serverOwnedFields() {
      return ['stats', 'currentStreak', 'longestStreak', 'lastStudyDate', 'lastStudyDay',
              'studyHistory', 'achievements', 'timezone'];
    }

    function zeroOrAbsent(m, key) {
      return !(key in m) || m[key] == 0;
    }

    function statsAreZero(stats) {
      return stats.keys().hasOnly(['totalCards', 'cardsLearned', 'quizzesTaken', 'flashcardSessions',
                                   'totalStudyTime', 'perfectQuizzes', 'gamesPlayed'])
        && zeroOrAbsent(stats, 'totalCards') && zeroOrAbsent(stats, 'cardsLearned')
        && zeroOrAbsent(stats, 'quizzesTaken') && zeroOrAbsent(stats, 'flashcardSessions')
        && zeroOrAbsent(stats, 'totalStudyTime') && zeroOrAbsent(stats, 'perfectQuizzes')
        && zeroOrAbsent(stats, 'gamesPlayed');
    }

    // Новый профиль клиент создаёт сам, но только «с нуля»
    function isBlankProfile(d) {
      return zeroOrAbsent(d, 'currentStreak') && zeroOrAbsent(d, 'longestStreak')
        && (!('achievements' in d) || d.achievements.size() == 0)
        && (!('studyHistory' in d) || d.studyHistory.size() == 0)
        && (!('lastStudyDate' in d) || d.lastStudyDate == null)
        && !('lastStudyDay' in d) && !('timezone' in d)
        && (!('stats' in d) || statsAreZero(d.stats));
    }

    // Профиль: владелец читает и меняет своё (имя, фото, курсы, папки…), кроме полей сервера
    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId) && isBlankProfile(request.resource.data);
      allow update: if isOwner(userId)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOwnedFields());

      // Наборы и карточки (включая интервалы повторения) — личные данные владельца
      match /collections/{collectionId} {
        allow read, write: if isOwner(userId);
      }

      // Журнал тренировок пишет только сервер; владелец читает и удаляет (удаление аккаунта)
      match /sessions/{sessionId} {
        allow read, delete: if isOwner(userId);
      }
    }

    // Daily game leaderboard:
    //   - Any signed-in user can read (needed for leaderboard display)
    //   - Users can only write their own score document
    match /dailyGame/{dateKey}/scores/{scoreUserId} {
      allow read: if isSignedIn();
      allow write: if isOwner(scoreUserId);
    }

    // Username uniqueness registry — foundation for friends/social lookup.
    // Doc id = normalized (lowercase) username, content = { uid }.
    // No native unique-constraints in Firestore, so the client always claims
    // via a transaction (see firebase/firestore.ts claimUsername): check the
    // doc is free, then create it. Only the owning uid may create/update/
    // delete their own claim — never someone else's.
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
