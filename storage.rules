rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Аватары профиля: avatars/{uid}/avatar.jpg — фиксированный путь,
    // новая загрузка перезаписывает старую (нет "осиротевших" файлов).
    // Читать может кто угодно (аватар встраивается как публичный <img src>,
    // в т.ч. в будущих соц-фичах вроде лидерборда/друзей).
    // Писать — только владелец, и только маленькую сжатую картинку:
    // клиент ужимает до ~512px/JPEG перед загрузкой (см. utils/avatarUpload.ts),
    // но лимит здесь — независимая серверная защита от порчи/злоупотребления.
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Всё остальное запрещено
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
